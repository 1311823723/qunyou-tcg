.tile{color:#eee9df;min-width:0}.cover-wrap{position:relative}.cover{width:100%;height:auto;aspect-ratio:750 / 1050;display:block;border-radius:8px;background:#151d27}.fallback{min-height:180px;display:flex;flex-direction:column;justify-content:center;text-align:center;box-sizing:border-box;padding:10px}.placeholder{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;justify-content:center;align-items:center;box-sizing:border-box;padding:10px;text-align:center;background:linear-gradient(160deg,#182231,#121a24);animation:phPulse 1.6s ease-in-out infinite}.ph-name{font-size:14px;line-height:1.5;color:#8d9aab;overflow-wrap:anywhere}.name{font-size:14px;line-height:1.5;margin-top:8px;overflow-wrap:anywhere}.hint{font-size:12px;line-height:1.6;color:#a5afbd;margin-top:4px}button{font-size:13px;color:#90ddd0;background:#202c36;min-height:44px;margin-top:10px}
@media(prefers-reduced-motion:reduce){.placeholder{animation:none}}
@keyframes phPulse{0%{opacity:.6}50%{opacity:1}100%{opacity:.6}}
