<view class="home-page {{reduceMotion ? 'reduced' : 'fade'}}">
<view class="library-scene"><image class="library-background" src="/assets/collector-library.jpg" mode="aspectFill" aria-hidden="true"/><view class="library-content">
<view class="brand-row"><view class="grow"><view class="brand-title">宝旅团 <text class="brand-tcg">TCG</text></view></view><button class="ghost" bindtap="website">官网 ↗</button></view>
<button class="searchbar" bindtap="search" aria-label="搜索卡牌"><image class="ui-icon" src="/assets/icons/search.png"/><text class="searchbar-text">搜索卡名、技能、效果</text></button>
<view class="spotlight-label"><view class="rule-line"/><text>本体精选 · {{spotlight.archetype}}</text><view class="rule-line"/></view>
<view class="showcase-cards"><image class="showcase-back back-left" src="/assets/showcase-back.jpg" mode="aspectFit" aria-hidden="true"/><image class="showcase-back back-right" src="/assets/showcase-back.jpg" mode="aspectFit" aria-hidden="true"/><image class="showcase-front" src="/assets/showcase-body.jpg" mode="aspectFit" bindtap="spotlightCard" aria-label="查看{{spotlight.bodyName}}完整卡牌"/></view>
<view class="spotlight-copy"><view class="spotlight-name">{{spotlight.bodyName}}</view><view class="spotlight-deck">{{spotlight.name}} · {{spotlight.archetype}}</view><button class="primary spotlight-button" data-id="{{spotlight.id}}" bindtap="deck">查看预组 <text>→</text></button></view>
</view></view>
<view class="home-shelf">
<view class="quick-links"><button class="quick-link" data-key="cards" bindtap="entry"><image class="entry-icon" src="/assets/icons/cards.png"/><view><view class="quick-title">卡牌图鉴</view><view class="quiet">查卡面与完整效果</view></view><text class="quick-arrow">›</text></button><button class="quick-link" data-key="rules" bindtap="entry"><image class="entry-icon" src="/assets/icons/book-2.png"/><view><view class="quick-title">快速入门</view><view class="quiet">从开局到出牌</view></view><text class="quick-arrow">›</text></button></view>
<view class="row between"><view class="subheading">预组一览</view><button class="link" data-key="decks" bindtap="entry">全部预组 →</button></view>
<scroll-view scroll-x class="deck-strip"><view class="preview-deck" wx:for="{{decks}}" wx:key="id" data-id="{{item.id}}" bindtap="deck" role="button" aria-label="{{item.name}}"><image class="preview-art" src="{{item.portrait}}" mode="aspectFill"/><view class="preview-copy"><view class="mini-title">{{item.name}}</view><view class="preview-archetype">{{item.archetype}}</view></view></view></scroll-view>
<block wx:if="{{favorites.length}}"><view class="row between"><view class="subheading">我的收藏</view><button class="link" bindtap="favorites">查看全部</button></view><scroll-view scroll-x class="scroller"><view class="recent-card" wx:for="{{favorites}}" wx:key="id"><card-tile card="{{item}}" bindopen="open"/></view></scroll-view></block>
<block wx:if="{{recent.length}}"><view class="row between"><view class="subheading">最近浏览</view><button class="link" bindtap="history">查看全部</button></view><scroll-view scroll-x class="scroller"><view class="recent-card" wx:for="{{recent}}" wx:key="id"><card-tile card="{{item}}" bindopen="open"/></view></scroll-view></block>
<view class="version">收藏与浏览记录保存在本机</view></view></view>
