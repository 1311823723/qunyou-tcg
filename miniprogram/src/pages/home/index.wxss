.home-page{max-width:860px;margin:auto;background:#111416}.library-scene{position:relative;overflow:hidden}.library-background{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}.library-content{position:relative;padding:12px 20px 24px;background:linear-gradient(180deg,rgba(10,12,17,.12),transparent 60%,#111416 100%)}.brand-row{align-items:center;margin:0}.brand-title{font-size:27px;letter-spacing:3px;font-weight:650;text-shadow:0 2px 8px #08090c}.brand-tcg{font-size:12px;letter-spacing:2px;color:#d0b991;font-weight:500}.ghost{min-height:44px;background:rgba(14,17,23,.54);padding:10px 12px;border-color:rgba(220,186,130,.3);border-radius:7px}.searchbar{height:46px;min-height:46px;margin:12px 0 16px;background:rgba(11,16,22,.82);border-color:rgba(212,185,141,.38);border-radius:7px;box-shadow:0 3px 12px #080c1260;padding:0 14px}.ui-icon{width:20px;height:20px;flex-shrink:0}.searchbar-text{color:#c5bdb1;font-size:14px}.spotlight-label{display:flex;align-items:center;justify-content:center;gap:14px;color:#dfc396;font-size:12px;letter-spacing:4px}.rule-line{height:1px;width:48px;background:linear-gradient(90deg,transparent,#ad875c,transparent)}.collector-hero{display:block;width:100%;height:320px;margin:0 auto -3px;filter:drop-shadow(0 12px 12px rgba(0,0,0,.35))}.spotlight-copy{text-align:center;text-shadow:0 2px 10px #000}.spotlight-name{font-size:26px;line-height:1.4;letter-spacing:3px;font-weight:600;color:#f6e8cb}.spotlight-deck{color:#d4bc9b;font-size:13px;margin:5px 0 14px;letter-spacing:1px}.spotlight-button{width:178px;margin:auto;min-height:44px;display:flex;align-items:center;justify-content:space-between;border-radius:6px;text-shadow:none}.home-shelf{padding:0 20px 24px}.quick-links{display:flex;border-top:1px solid #ae885c55;border-bottom:1px solid #ae885c40;padding:14px 0;gap:12px}.quick-link{display:flex;align-items:center;gap:10px;flex:1;min-width:0;padding:0;border:0;background:none;border-radius:0;box-shadow:none;text-align:left}.quick-link:first-child{border-right:1px solid #ae885c40;padding-right:12px}.entry-icon{width:25px;height:25px;flex-shrink:0}.quick-title{font-size:15px;color:#e8d9be;font-weight:600}.quick-link .quiet{font-size:10px;color:#a9a39a;white-space:nowrap}.quick-arrow{font-size:20px;color:#baa07c;margin-left:auto}.home-shelf .subheading{margin:20px 0 14px;font-size:18px}.home-shelf .link{color:#bfa77f;font-size:12px;padding-right:0}.deck-strip{width:100%;white-space:nowrap;padding-bottom:4px}.preview-deck{display:inline-block;position:relative;width:46%;height:174px;margin-right:12px;vertical-align:top;overflow:hidden;border:1px solid #91704b77;border-radius:7px;background:#252125;white-space:normal}.preview-deck:last-child{margin-right:0}.preview-art{width:100%;height:100%;display:block}.preview-copy{position:absolute;bottom:0;left:0;right:0;padding:25px 12px 10px;background:linear-gradient(transparent,rgba(9,13,17,.95));color:#f2e1c1}.preview-copy .mini-title{font-size:17px;margin:0}.preview-archetype{font-size:11px;color:#d4b791}.home-shelf .version{color:#9a958b;text-align:center}@media(max-width:340px){.library-content{padding:10px 14px 20px}.home-shelf{padding-left:14px;padding-right:14px}.collector-hero{height:278px}.brand-title{font-size:24px}.quick-links{gap:8px}.quick-link{gap:6px}.entry-icon{width:20px;height:20px}.quick-title{font-size:14px}.quick-arrow{display:none}.preview-deck{height:156px}}@media(min-width:600px){.collector-hero{height:360px;width:380px}.library-background{object-position:center}.library-content{padding-left:36px;padding-right:36px}.home-shelf{padding-left:36px;padding-right:36px}.preview-deck{width:31%;height:220px}}

.showcase-cards{position:relative;height:348px;margin:12px 0 4px}.showcase-front{position:absolute;height:100%;width:100%;left:0;top:0;filter:drop-shadow(0 8px 12px #0009)}.showcase-back{position:absolute;top:32px;width:67%;height:82%;opacity:.83}.back-left{left:-18px;transform:rotate(-12deg)}.back-right{right:-18px;transform:rotate(12deg)}@media(max-width:340px){.showcase-cards{height:306px}.showcase-back{width:64%}}@media(min-width:600px){.showcase-cards{height:390px;max-width:430px;margin-left:auto;margin-right:auto}}

.exhibit-swiper,.exhibit-stage{width:100%;height:100%}.exhibit-stage{position:relative;perspective:1000px}.exhibit-controls{display:flex;align-items:center;justify-content:center;gap:12px;margin:10px 0 14px}.exhibit-controls button{min-width:44px;min-height:44px;background:#101820c9;border-color:#c4a47766;color:#dfc394;padding:5px 12px;font-size:24px}.exhibit-controls .flip-button{font-size:13px;padding:10px 12px}.exhibit-position{font-size:12px;color:#dec59a;text-align:center;min-width:55px;line-height:1.5}.exhibit-position view{font-size:10px;color:#bdb4a3}.exhibit-effect-toggle{font-size:12px;margin:10px auto 0;color:#c6b18c}.exhibit-effects{background:#12171cee;border:1px solid #a78f6233;border-radius:8px;padding:16px;margin-top:10px}.exhibit-effect{margin-top:14px}.exhibit-effect .section-title{font-size:13px}.exhibit-error{font-size:13px;text-align:center;color:#d5c1a1}.exhibit-error button{display:inline-block;font-size:13px}.exhibit-flip-in{animation:exhibitIn .36s ease-in-out both;backface-visibility:hidden}.exhibit-flip-out{animation:exhibitOut .36s ease-in-out both;pointer-events:none;backface-visibility:hidden}@keyframes exhibitIn{0%,49%{transform:rotateY(90deg);opacity:0}50%{transform:rotateY(90deg);opacity:.5}100%{transform:rotateY(0);opacity:1}}@keyframes exhibitOut{0%{transform:rotateY(0);opacity:1}49%{transform:rotateY(-90deg);opacity:.5}50%,100%{transform:rotateY(-90deg);opacity:0}}.reduced .exhibit-flip-in{animation:none}.reduced .exhibit-flip-out{display:none}@media(prefers-reduced-motion:reduce){.exhibit-flip-in{animation:none}.exhibit-flip-out{display:none}}

.exhibit-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:44px;min-height:52px;padding:0;border:1px solid #ccad7377;border-radius:8px;background:linear-gradient(180deg,#172029e8,#121920f2);color:#ecd29f;font-size:32px;line-height:50px;text-align:center;box-shadow:0 4px 12px #100d0999}.exhibit-arrow-left{left:-12px}.exhibit-arrow-right{right:-12px}.exhibit-arrow:active{background:#4b3a26}.exhibit-controls{gap:18px;margin-top:12px}.turn-back .exhibit-flip-in{animation-name:exhibitBackIn}.turn-back .exhibit-flip-out{animation-name:exhibitBackOut}@keyframes exhibitBackIn{0%,49%{transform:rotateY(-90deg);opacity:0}50%{transform:rotateY(-90deg);opacity:.5}100%{transform:rotateY(0);opacity:1}}@keyframes exhibitBackOut{0%{transform:rotateY(0);opacity:1}49%{transform:rotateY(90deg);opacity:.5}50%,100%{transform:rotateY(90deg);opacity:0}}

.home-footer{margin-top:22px;padding-top:12px;border-top:1px solid #aa927a26;text-align:center}
.home-footer .link{font-size:13px;color:#bfa77f;margin-top:2px}
