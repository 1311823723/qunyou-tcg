<view class="screen detail-screen {{reduceMotion ? 'reduced' : 'fade'}}"><block wx:if="{{card}}">
<view class="eyebrow">{{card.kind}}<text wx:if="{{card.role}}"> / {{card.role}}</text></view>
<view class="row detail-title-row"><view class="heading grow">{{card.name}}</view><button class="save-button {{favorite ? 'active' : ''}}" bindtap="favorite" aria-label="{{favorite ? '取消收藏' : '收藏卡牌'}}">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button></view>
<view class="detail-layout"><view class="visual-column">
<view class="face-switch" wx:if="{{card.kind === '本体'}}"><button wx:for="{{card.faces}}" wx:key="label" class="{{faceIndex === index ? 'face-selected' : ''}}" data-index="{{index}}" bindtap="switchFace">{{item.label}}</button></view>
<picker wx:elif="{{card.faces.length > 1}}" range="{{card.faces}}" range-key="label" value="{{faceIndex}}" bindchange="pickFace"><button class="print-picker">卡面版本 <text>{{card.faces[faceIndex].label}} ▾</text></button></picker>
<view class="card-gallery"><block wx:if="{{imageFailed}}"><view class="image-message"><view class="section-title">卡面暂时未能加载</view><view class="quiet">完整效果仍可在下方阅读</view><button bindtap="retry">重新加载</button></view></block><block wx:elif="{{image}}"><image wx:for="{{visibleFaces}}" wx:key="key" class="detail-image face-image" src="{{item.image}}" mode="aspectFit" bindtap="preview" bindload="imageLoaded" binderror="imageError" aria-label="查看高清卡面"/><view wx:if="{{!imageReady}}" class="loading-caption">正在载入卡面 · 可先阅读文字</view></block><view wx:else class="image-message"><view class="section-title">文字卡牌</view><view class="quiet">尚无正式成卡图</view></view></view>
<view class="gallery-actions"><button class="link" wx:if="{{image}}" bindtap="preview">查看高清图 ↗</button><button class="link" bindtap="readEffect">阅读效果 ↓</button></view>
</view><view class="reading-column" id="effect-text">
<view class="effect-heading"><view><view class="eyebrow">卡牌文字</view><view class="subheading">{{faceLabel}}</view></view><button class="link" bindtap="copyEffect">复制文字</button></view>
<view class="chips"><text wx:for="{{card.tags}}" wx:key="*this" class="tag">{{item}}</text></view>
<view class="card-facts"><view wx:for="{{summarySections}}" wx:key="key" class="card-fact"><view class="fact-label">{{item.title}}</view><text class="fact-value" user-select>{{item.text}}</text></view></view>
<view class="effect-section" wx:for="{{effectSections}}" wx:key="key"><view class="section-title">{{item.title}}</view><text class="prose" user-select>{{item.text}}</text></view>
<view wx:if="{{decks.length}}" class="related-decks"><view class="subheading">收录预组</view><button wx:for="{{decks}}" wx:key="id" data-id="{{item.id}}" bindtap="deck" class="related-deck"><view><view>{{item.name}}</view><view class="quiet">{{item.archetype}}</view></view><text>→</text></button></view>
<view class="detail-footer"><button open-type="share">分享卡牌</button><button class="link" bindtap="back">前往图鉴 →</button></view>
<view class="version">收藏保存在本机，不表示拥有实体卡。<view>文字版本 {{version}}</view></view>
</view></view></block><view wx:else class="empty"><view class="heading">未找到这张卡</view><view class="quiet">卡牌可能已移除，可以返回图鉴重新查找。</view><button bindtap="back">返回图鉴</button></view></view>