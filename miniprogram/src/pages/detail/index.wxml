<view class="screen detail-screen {{reduceMotion ? 'reduced' : 'fade'}}"><block wx:if="{{card}}"><view class="eyebrow">{{card.kind}} / CARD ARCHIVE</view><view class="row between"><view class="heading grow">{{card.name}}</view><button class="{{favorite ? 'active' : ''}}" bindtap="favorite" aria-label="{{favorite ? '取消收藏' : '收藏卡牌'}}">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button></view>
<view wx:if="{{fromShare}}" class="notice">可在下方阅读完整效果，也可以前往图鉴继续查卡。</view>
<view wx:if="{{card.kind === '本体'}}" class="row face"><button wx:for="{{card.faces}}" wx:key="label" class="{{faceIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchFace">{{item.label}}</button></view><picker wx:elif="{{card.faces.length > 1}}" range="{{card.faces}}" range-key="label" value="{{faceIndex}}" bindchange="pickFace"><button class="face">花色与点数 · {{card.faces[faceIndex].label}} ▾</button></picker>
<block wx:if="{{imageFailed}}"><view class="empty">图片暂不可用，下方可阅读完整效果。<button bindtap="retry">重试图片</button></view></block>
<block wx:elif="{{image}}"><image wx:for="{{visibleFaces}}" wx:key="key" class="detail-image face-image" src="{{item.image}}" mode="aspectFit" bindtap="preview" binderror="imageError" aria-label="查看高清卡面"/><view class="quiet">点击卡面查看高清图</view></block>
<view wx:else class="empty">暂无正式成卡图，以下为正式文字详情。</view>
<view class="chips"><text wx:if="{{card.role}}" class="tag">{{card.role}}</text><text wx:for="{{card.tags}}" wx:key="*this" class="tag">{{item}}</text></view><view class="section" wx:for="{{sections}}" wx:key="key"><view class="section-title">{{item.title}}</view><text class="prose" user-select>{{item.text}}</text></view>
<view wx:if="{{decks.length}}" class="section"><view class="section-title">收录预组</view><button wx:for="{{decks}}" wx:key="id" data-id="{{item.id}}" bindtap="deck" class="link">{{item.name}} · {{item.archetype}} →</button></view><view class="row"><button open-type="share">分享这张卡</button><button class="{{fromShare ? 'primary' : 'link'}}" bindtap="back">前往图鉴</button></view><view class="version">收藏保存在本机，不表示拥有实体卡。文字版本 {{version}}</view></block><view wx:else class="empty">没有找到这张卡，可能已移除。<button bindtap="back">返回图鉴</button></view></view>