.detail-title-row{flex-wrap:nowrap;align-items:flex-start;margin-bottom:16px}.save-button{font-size:13px;flex-shrink:0;margin-top:5px}.detail-layout{display:block}.face-switch{display:flex;padding:4px;background:#252225;border:1px solid #a98b5640;border-radius:9px;margin-bottom:14px}.face-switch button{flex:1;border:0;background:transparent;font-size:14px;color:#aaa79f}.face-switch .face-selected{background:#554431;color:#f3dfb9}.print-picker{width:100%;display:flex;justify-content:space-between;gap:10px;font-size:14px;margin-bottom:14px}.card-gallery{position:relative;border-radius:12px;padding:14px 8px;background:radial-gradient(ellipse at 50% 45%,#413130,#1c1c23 65%,#161b21);border:1px solid #c9a66a2e;min-height:190px}.detail-screen .detail-image{height:410px;max-height:62vh;filter:drop-shadow(0 6px 10px #0008)}.loading-caption{position:absolute;bottom:16px;left:10px;right:10px;text-align:center;background:#14171ded;padding:6px;font-size:12px;color:#d8c7aa;pointer-events:none}.image-message{text-align:center;padding:40px 12px}.image-message button{margin:18px auto 0;font-size:14px;max-width:180px}.gallery-actions{display:flex;justify-content:space-between;padding:3px 0}.gallery-actions .link{font-size:12px;color:#c6b48f}.reading-column{padding-top:18px}.effect-heading{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #aa927a33;padding-bottom:12px}.effect-heading .subheading{margin:4px 0 0;font-size:21px}.effect-heading button{font-size:12px}.detail-screen .chips{margin:16px 0 4px}.effect-section{padding:18px 0;border-bottom:1px solid #a58f7124}.effect-section .section-title{font-size:14px;letter-spacing:.5px}.effect-section .prose{display:block}.related-deck{display:flex;justify-content:space-between;align-items:center;text-align:left;width:100%;background:transparent;border:0;border-bottom:1px solid #a58f7124;padding:12px 0;border-radius:0;font-size:16px}.related-deck .quiet{font-size:12px}.detail-footer{display:flex;gap:8px;margin-top:26px}.detail-footer button{flex:1;font-size:14px}@media(min-width:680px){.detail-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:28px;align-items:start}.reading-column{padding-top:0}.detail-screen .detail-image{max-height:none;height:400px}}@media(max-width:340px){.detail-screen .detail-image{height:345px}.save-button{padding:9px;font-size:12px}.detail-screen .heading{font-size:22px}}
.card-facts{display:flex;flex-wrap:wrap;gap:12px 22px;padding:15px 0;border-bottom:1px solid #aa927a33}.card-fact{flex:1;min-width:90px}.fact-label{color:#b3a68e;font-size:12px;margin-bottom:5px}.fact-value{font-size:15px;line-height:1.8;color:#eee6d7;display:block}
