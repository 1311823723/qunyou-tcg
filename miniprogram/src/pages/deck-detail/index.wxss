.deck-exhibit-panel{position:relative;height:240px;margin-top:60px;margin-bottom:24px;border:1px solid #b8946255;border-radius:9px;background:radial-gradient(ellipse at 65% 40%,#744944,#241d21 70%)}.deck-exhibit{position:absolute;bottom:0;left:0;width:100%;height:295px;display:block;filter:drop-shadow(0 5px 8px #0006)}@media(orientation:landscape){.deck-exhibit-panel{height:180px}.deck-exhibit{height:235px}}

.deck-art{border-radius:10px;height:240px;margin-bottom:24px}.deck-intro .heading{font-size:30px;margin:6px 0 12px}.roster-jump{padding-left:0;font-size:13px;margin-top:10px}.strategy{margin:18px 0 24px;padding:18px;border-left:2px solid #be9c66;background:#d9b77809}.strategy .section-title{font-size:12px;letter-spacing:2px}.strategy .prose{font-size:15px}.body-summary{display:flex;gap:22px;align-items:center;padding-bottom:26px;border-bottom:1px solid #a58f7133}.body-thumbnail{width:120px;flex-shrink:0}.body-description{min-width:0}.body-description .subheading{font-size:20px;margin:7px 0}.body-description .link{padding-left:0;font-size:13px;margin-top:8px}.roster .subheading{margin-bottom:10px}.all-decks{margin:28px auto 0;font-size:14px}@media(max-width:340px){.body-summary{gap:15px}.body-thumbnail{width:105px}.body-description .subheading{font-size:18px}}@media(min-width:680px){.deck-art{height:280px}.body-thumbnail{width:140px}}
