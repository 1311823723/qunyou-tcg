<view class="screen deck-detail"><block wx:if="{{deck}}">
<view wx:if="{{deck.id === exhibit.deckId}}" class="deck-exhibit-panel"><image class="deck-exhibit" src="{{exhibit.characterArt}}" mode="aspectFit" aria-label="本体主题插画"/></view><image wx:else class="deck-art" src="{{deck.portrait}}" mode="aspectFill"/>
<view class="deck-intro"><view class="eyebrow">{{deck.archetype}}</view><view class="heading">{{deck.name}}</view><text class="prose" user-select>{{deck.summary}}</text><button class="link roster-jump" bindtap="roster">查看 {{members.length}} 张角色 ↓</button></view>
<view class="strategy"><view class="section-title">核心操作</view><text class="prose" user-select>{{deck.core}}</text></view>
<view class="body-summary"><view class="body-thumbnail"><card-tile card="{{body}}" bindopen="open"/></view><view class="body-description"><view class="eyebrow">本体</view><view class="subheading">{{deck.bodyName}}</view><view class="quiet">查看完整技能与额外形态</view><button class="link" bindtap="body">查看卡牌 →</button></view></view>
<view id="roster" class="roster"><view class="row between"><view class="subheading">角色卡册</view><text class="quiet">{{members.length}} 张角色</text></view><view class="quiet">按定位查看，点击卡牌阅读技能。</view>
<scroll-view scroll-x class="filter-scroll"><view class="chips"><button class="chip {{role === '全部' ? 'chip-on' : ''}}" data-role="全部" bindtap="filter">全部</button><button class="chip {{role === item.name ? 'chip-on' : ''}}" wx:for="{{roles}}" wx:key="name" data-role="{{item.name}}" bindtap="filter">{{item.name}} {{item.count}}</button></view></scroll-view>
<view class="grid"><card-tile wx:for="{{visibleMembers}}" wx:key="id" card="{{item}}" bindopen="open"/></view></view><button class="all-decks link" bindtap="back">浏览其他预组 →</button>
</block><view class="empty" wx:else><view class="heading">未找到这套预组</view><button bindtap="back">返回预组</button></view></view>