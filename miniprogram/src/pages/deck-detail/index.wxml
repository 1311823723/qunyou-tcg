<view class="screen"><block wx:if="{{deck}}"><view wx:if="{{deck.id === exhibit.deckId}}" class="deck-exhibit-panel"><image class="deck-exhibit" src="{{exhibit.characterArt}}" mode="aspectFit" aria-label="本体主题插画"/></view><image wx:else class="deck-art" src="{{deck.portrait}}" mode="aspectFill"/><view class="eyebrow">{{deck.archetype}}</view><view class="heading">{{deck.name}}</view><text class="prose" user-select>{{deck.summary}}</text><view class="section"><view class="section-title">核心操作</view><text class="prose" user-select>{{deck.core}}</text><view class="quiet">具体发动时机与费用，请打开卡牌查看正式效果。</view></view><view class="subheading">本体 · {{deck.bodyName}}</view><view style="max-width:220px"><card-tile card="{{body}}" bindopen="open"/></view><view class="subheading">十六位伙伴</view><view class="grid"><card-tile wx:for="{{members}}" wx:key="id" card="{{item}}" bindopen="open"/></view></block><view class="empty" wx:else>未找到这套预组。<button bindtap="back">返回预组</button></view></view>