<view class="screen {{reduceMotion ? 'reduced' : 'fade'}}"><view class="eyebrow">DECK COLLECTION</view><view class="heading">预组</view><view class="quiet">{{decks.length}} 套预组 · 查看本体、打法与角色配置</view><view class="grid explore"><view class="deck-tile" wx:for="{{decks}}" wx:key="id" data-id="{{item.id}}" bindtap="deck" role="button" aria-label="{{item.name}}"><image class="small-art" src="{{item.portrait}}" mode="aspectFill" lazy-load/><view class="deck-caption"><view class="mini-title">{{item.name}}</view><view class="deck-archetype">{{item.archetype}}</view><view class="quiet">{{item.summary}}</view></view></view></view></view>