<view class="screen {{reduceMotion ? 'reduced' : ''}}"><view class="eyebrow">LEARN & EXPLORE</view><view class="heading">出发前的指南</view><view class="row"><button data-mode="start" bindtap="mode" class="{{mode === 'start' ? 'active' : ''}}">快速入门</button><button data-mode="rules" bindtap="mode" class="{{mode === 'rules' ? 'active' : ''}}">完整规则</button><button data-mode="keywords" bindtap="mode" class="{{mode === 'keywords' ? 'active' : ''}}">关键词</button></view>
<block wx:if="{{mode === 'start'}}"><view wx:for="{{steps}}" wx:key="title" class="section"><view class="subheading">0{{index + 1}} / {{item.title}}</view><view class="tutorial-card"><card-tile card="{{item.card}}" bindopen="open"/></view><text class="prose" user-select>{{item.text}}</text><view class="clear"/></view><view class="notice">入门是阅读指引，具体裁定请查正式规则与卡牌文字。</view><button data-mode="rules" bindtap="mode">继续阅读完整规则 →</button></block>
<block wx:elif="{{mode === 'rules'}}"><view class="subheading">章节目录</view><button wx:for="{{sections}}" wx:key="anchor" class="link" data-anchor="{{item.anchor}}" bindtap="chapter">{{item.title}} ↓</button><view wx:for="{{sections}}" wx:key="anchor" id="{{item.anchor}}" class="section"><view class="subheading">{{item.title}}</view><document-blocks blocks="{{item.blocks}}"/><button class="link" bindtap="top">返回目录 ↑</button></view></block>
<block wx:else><input class="search" value="{{query}}" bindinput="search" placeholder="搜索规则术语" aria-label="搜索关键词"/><view wx:for="{{keywords}}" wx:key="anchor" class="section"><view class="section-title">{{item.title}}</view><document-blocks blocks="{{item.blocks}}"/></view><view wx:if="{{!keywords.length}}" class="empty">没有找到这个术语。</view></block><view class="section row between"><text class="quiet">减少动态效果</text><switch checked="{{reduceMotion}}" bindchange="motion" color="#68bdae" aria-label="减少动态效果"/></view><view class="version">规则随包可离线阅读 · {{version}}</view></view>