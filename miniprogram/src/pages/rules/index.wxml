<view class="screen guide-screen {{reduceMotion ? 'reduced' : ''}}">
<view class="guide-heading"><image class="guide-icon" src="/assets/icons/book-2.png"/><view><view class="eyebrow">入门与规则</view><view class="heading">对战指南</view></view></view>
<view class="guide-tabs"><button data-mode="start" bindtap="mode" class="{{mode === 'start' ? 'selected' : ''}}">快速入门</button><button data-mode="rules" bindtap="mode" class="{{mode === 'rules' ? 'selected' : ''}}">完整规则</button><button data-mode="keywords" bindtap="mode" class="{{mode === 'keywords' ? 'selected' : ''}}">关键词</button></view>
<block wx:if="{{mode === 'start'}}">
<view class="guide-intro"><view class="subheading">从第一局开始</view><view class="quiet">{{steps.length}} 个步骤，了解开局、出牌与结算。</view></view>
<view class="lesson-contents"><button wx:for="{{steps}}" wx:key="anchor" data-anchor="{{item.anchor}}" bindtap="lesson"><text class="lesson-number">0{{index + 1}}</text><text>{{item.title}}</text><text class="lesson-arrow">↓</text></button></view>
<view wx:for="{{steps}}" wx:key="anchor" id="{{item.anchor}}" class="lesson"><view class="lesson-label">步骤 0{{index + 1}}</view><view class="subheading">{{item.title}}</view><view class="lesson-body"><text class="prose" user-select>{{item.text}}</text><view class="lesson-card"><card-tile card="{{item.card}}" bindopen="open"/></view></view><button class="link lesson-back" bindtap="top">返回入门目录 ↑</button></view>
<view class="notice">入门是阅读指引，具体裁定请查正式规则与卡牌文字。</view><button class="primary guide-continue" data-mode="rules" bindtap="mode">查阅完整规则 →</button></block>
<block wx:elif="{{mode === 'rules'}}">
<block wx:if="{{currentChapter}}"><view class="reader-top"><button class="link" bindtap="contents">‹ 章节目录</button><text class="quiet">{{chapterIndex + 1}} / {{sections.length}}</text></view><view class="chapter-title">{{currentChapter.title}}</view><view class="rule-reading"><document-blocks blocks="{{currentChapter.blocks}}"/></view><view class="reader-navigation"><button disabled="{{chapterIndex === 0}}" bindtap="previous">← 上一章</button><button class="primary" wx:if="{{chapterIndex < sections.length - 1}}" bindtap="next">下一章 →</button><button wx:else bindtap="contents">返回目录</button></view></block>
<block wx:else><view class="guide-intro"><view class="subheading">章节目录</view><view class="quiet">{{sections.length}} 个章节 · 按需查阅，离线可读</view></view><view class="chapter-list"><button wx:for="{{sections}}" wx:key="anchor" data-anchor="{{item.anchor}}" bindtap="chapter"><text class="chapter-number">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text><text class="grow">{{item.title}}</text><text class="chapter-arrow">›</text></button></view></block></block>
<block wx:else><input class="search" value="{{query}}" bindinput="search" placeholder="搜索术语或解释内容" aria-label="搜索关键词"/><view class="row between"><text class="quiet">{{keywords.length}} 个条目</text><button wx:if="{{query}}" class="link" bindtap="clearSearch">清空搜索</button></view><view wx:for="{{keywords}}" wx:key="anchor" class="keyword-entry"><view class="section-title">{{item.title}}</view><document-blocks blocks="{{item.blocks}}"/></view><view wx:if="{{!keywords.length}}" class="empty"><view class="subheading">没有找到相关术语</view><view class="quiet">试试更短的关键词，或查看全部条目。</view><button bindtap="clearSearch">查看全部关键词</button></view></block>
<view class="guide-settings row between"><text class="quiet">减少动态效果</text><switch checked="{{reduceMotion}}" bindchange="motion" color="#68bdae" aria-label="减少动态效果"/></view><view class="version">规则随包可离线阅读 · {{version}}</view></view>
