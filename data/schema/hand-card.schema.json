{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "手牌",
  "type": "object",
  "required": ["id", "name", "cardType", "handType", "tags", "timing", "effectText", "cards"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "cardType": { "type": "string", "const": "手牌" },
    "handType": { "type": "string", "enum": ["基础", "行动"] },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string" }
    },
    "timing": { "type": "string" },
    "effectText": { "type": "string" },
    "cards": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["suit", "rank"],
            "properties": {
              "suit": { "type": "string", "enum": ["黑桃", "红桃", "梅花", "方块"] },
              "rank": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["joker"],
            "properties": {
              "joker": { "type": "string", "enum": ["small", "big"] }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
