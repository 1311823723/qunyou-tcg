{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "骑士卡",
  "type": "object",
  "required": ["id", "bodyId", "name", "cardType", "mainRole", "call", "tag", "normal", "final"],
  "properties": {
    "id": { "type": "string", "pattern": "^rider_[a-z]+$" },
    "bodyId": { "type": "string" },
    "name": { "type": "string" },
    "cardType": { "type": "string", "const": "骑士卡" },
    "mainRole": { "enum": ["强攻", "防御", "资源", "控制", "支援", "伏击"] },
    "call": { "type": "string" },
    "tag": { "type": "string" },
    "normal": { "$ref": "#/definitions/form" },
    "final": { "$ref": "#/definitions/form" }
  },
  "additionalProperties": false,
  "definitions": {
    "form": {
      "type": "object",
      "required": ["cost", "timing", "effectText"],
      "properties": {
        "cost": {
          "type": "object",
          "required": ["consumeSelf", "retireSameRole", "dynamaxEnergy"],
          "properties": {
            "consumeSelf": { "const": true },
            "retireSameRole": { "const": 1 },
            "dynamaxEnergy": { "enum": [0, 1] }
          },
          "additionalProperties": false
        },
        "timing": { "type": "string" },
        "effectText": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
