---
import Layout from "../components/Layout.astro";
import PageHeader from "../components/PageHeader.astro";

const phases = ["准备阶段", "摸牌阶段", "出牌阶段", "布阵阶段", "弃牌阶段", "结束阶段"];
const keywords = ["本体", "额外形态", "Mega", "Z招式", "暗置", "明置", "休整", "退场", "伏击", "充能球", "濒死", "共用手牌牌堆"];
const setupStats = [
  ["1", "本体", "公开核心角色"],
  ["16", "角色牌", "暗置与技能来源"],
  ["52", "共用手牌", "基础牌与行动牌"],
  ["5+2", "起手", "手牌 + 上阵角色"],
];
---
<Layout title="规则">
  <div class="page-wrap max-w-4xl rules-page">
    <PageHeader title="游戏规则" subtitle="玩家上手指南 · 本体承伤、角色暗置、休整发动、翻面激活额外形态。" badge="玩家必读" />

    <section class="hud-panel mb-8 scroll-reveal" style="padding: 1.25rem;">
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-5 items-center">
        <div>
          <h2 class="section-heading" style="font-size: 1.1rem; margin-bottom: 0.75rem;">胜利目标</h2>
          <p class="skill-text">
            每名玩家选择一张<strong>本体牌</strong>，搭配 16 张<strong>角色牌</strong>。双方共用 52 张<strong>手牌牌堆</strong>攻防；令对手进入濒死且无法用【急救】回复至 1 点或以上即可获胜。
          </p>
          <div class="flex flex-wrap gap-1 mt-4">
            {keywords.map((k) => <span class="tag-pill tag-pill--mech">{k}</span>)}
          </div>
        </div>
        <div class="stat-hud" style="grid-template-columns: repeat(2, 1fr);">
          {setupStats.map(([value, label, desc]) => (
            <div class="stat-hud__item" style="min-height: 5.8rem;">
              <div class="stat-hud__value" style="font-size: 1.65rem; color: var(--color-text-highlight);">{value}</div>
              <div class="stat-hud__label">{label}</div>
              <p class="text-xs mt-1" style="color: var(--text-faint);">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mb-8 scroll-reveal">
      <h2 class="section-heading" style="font-size: 1.15rem;">回合流程</h2>
      <div class="rules-phase-grid mb-4">
        {phases.map((phase, i) => (
          <div class="rules-phase">
            <div class="rules-phase__num">STEP {i + 1}</div>
            <div class="rules-phase__name">{phase}</div>
          </div>
        ))}
      </div>
      <div class="grid md:grid-cols-3 gap-3">
        <div class="hud-panel" style="padding: 1rem; border-top: 2px solid var(--color-role-defend);">
          <span class="text-sm font-bold" style="color: var(--color-role-defend);">摸牌阶段</span>
          <p class="skill-text mt-2">从共用手牌牌堆摸 2 张手牌；此阶段不上阵角色。</p>
        </div>
        <div class="hud-panel" style="padding: 1rem; border-top: 2px solid var(--color-aggro);">
          <span class="text-sm font-bold" style="color: var(--color-aggro);">出牌阶段</span>
          <p class="skill-text mt-2">使用基础牌、行动牌、本体技能；暗置角色满足时机可明置并发动技能。通常每回合限 1 张【出刀】。</p>
        </div>
        <div class="hud-panel" style="padding: 1rem; border-top: 2px solid var(--color-role-resource);">
          <span class="text-sm font-bold" style="color: var(--color-role-resource);">布阵阶段</span>
          <p class="skill-text mt-2">阶段开始时可从角色牌堆顶暗置上阵至多 2 张；之后可主动明置角色（不发动）。角色区最多 4 张。</p>
        </div>
        <div class="hud-panel" style="padding: 1rem; border-top: 2px solid var(--text-muted);">
          <span class="text-sm font-bold" style="color: var(--text-muted);">弃牌阶段</span>
          <p class="skill-text mt-2">先取当前体力和 4 中较小的数字，再加上己方明置角色数量；明置角色最多只计算 2 张。须弃牌至手牌上限以内。</p>
        </div>
        <div class="hud-panel" style="padding: 1rem; border-top: 2px solid var(--accent-info);">
          <span class="text-sm font-bold" style="color: var(--accent-info);">结束阶段</span>
          <p class="skill-text mt-2">「直到回合结束」「结束阶段开始时」等效果在此结算。</p>
        </div>
      </div>
    </section>

    <section class="mb-8 scroll-reveal">
      <h2 class="section-heading" style="font-size: 1.15rem;">
        <span class="section-heading__icon">⚔️</span>
        休整 vs 退场
      </h2>
      <div class="rules-compare">
        <div class="hud-panel" style="padding: 1.1rem; border-top: 2px solid var(--color-text-highlight);">
          <h3 class="font-bold" style="color: var(--color-text-highlight);">休整</h3>
          <p class="skill-text mt-2">将上阵角色放回角色牌堆底。支付任意【休整X】时，只要休整对象包含发动该技能的角色，休整后便摸 1 张手牌。</p>
        </div>
        <div class="hud-panel" style="padding: 1.1rem; border-top: 2px solid var(--color-role-attack);">
          <h3 class="font-bold" style="color: var(--color-role-attack);">退场</h3>
          <p class="skill-text mt-2">将角色放入退场区。强力技能代价，通常无法回收，设计需格外谨慎。</p>
        </div>
      </div>
    </section>

    <section class="mb-8 scroll-reveal">
      <h2 class="section-heading" style="font-size: 1.15rem;">使用、响应与结算</h2>
      <div class="hud-panel" style="padding: 1.1rem;">
        <ol class="space-y-2 pl-5 skill-text" style="list-style: decimal;">
          <li>声明使用牌或发动技能；暗置角色同时明置，并选择全部目标。</li>
          <li>处理费用修改效果，然后支付最终费用。费用支付后不会因效果被抵消而返还。</li>
          <li>牌或技能进入结算栈，由对手先获得响应机会，双方交替响应。</li>
          <li>双方连续放弃响应后，按后加入先结算的顺序处理；每个效果完整结算后再处理新触发。</li>
          <li>同一时机有多个己方技能触发时，由其拥有者决定顺序；同一技能对同一个事件最多发动一次。</li>
        </ol>
      </div>
    </section>

    <section class="mb-8 scroll-reveal">
      <h2 class="section-heading" style="font-size: 1.15rem;">濒死与牌堆重置</h2>
      <div class="rules-compare">
        <div class="hud-panel" style="padding: 1.1rem; border-top: 2px solid var(--color-role-attack);">
          <h3 class="font-bold" style="color: var(--color-role-attack);">濒死</h3>
          <p class="skill-text mt-2">体力降至 0 或以下时立即进入濒死。濒死玩家可以连续使用【急救】，回复至 1 点或以上后继续游戏；无法回复则失败。</p>
        </div>
        <div class="hud-panel" style="padding: 1.1rem; border-top: 2px solid var(--color-role-resource);">
          <h3 class="font-bold" style="color: var(--color-role-resource);">牌堆重置</h3>
          <p class="skill-text mt-2">需要摸牌、展示或判定而牌堆不足时，洗混手牌弃牌区形成新牌堆；正在结算或展示的牌不参与洗牌。</p>
        </div>
      </div>
    </section>

    <section class="rules-mega-highlight mb-8 scroll-reveal">
      <h2 class="section-heading" style="font-size: 1.15rem; margin-bottom: 0.75rem;">额外形态（翻面）</h2>
      <p class="skill-text">额外形态写在<strong>本体牌的背面</strong>，满足发动条件后翻面激活。发动条件<strong>写在本体牌正面</strong>。每张本体最多拥有一种额外形态。</p>
      <div style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <p class="skill-text"><strong>Mega：</strong>满足发动条件后翻至背面，获得强化技能，<strong>永久生效，不会翻回正面</strong>。</p>
        <p class="skill-text"><strong>Z招式：</strong>满足累计条件后翻面就绪，保留原本体技能并获得一次性主动Z招式；每局限发动一次，发动后保持翻面。</p>
        <p class="skill-text"><strong>极巨化：</strong>未来待定，设计方向是限时强化，持续结束后翻回正面。<strong>钛晶化</strong>等其他模式暂未确定。</p>
      </div>
    </section>

    <section class="mb-8 scroll-reveal">
      <h2 class="section-heading" style="font-size: 1.15rem;">开局流程</h2>
      <ol class="space-y-2 pl-5 skill-text" style="list-style: decimal;">
        <li>双方公开本体牌（正面朝上）；本体体力以本体牌标注为准。</li>
        <li>洗混各自 16 张角色牌组与共用 52 张手牌牌堆。</li>
        <li>双方各摸 5 张手牌，并从各自角色牌堆顶暗置上阵 2 张角色。</li>
        <li>决定先后手；先手开始第一回合。</li>
      </ol>
    </section>

    <section class="scroll-reveal">
      <h2 class="section-heading" style="font-size: 1.15rem;">特殊机制</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="mechanic-tile" style="--tile-color: var(--color-text-highlight);">
          <div class="mechanic-tile__icon">REST</div>
          <h3 class="mechanic-tile__title">休整自身</h3>
          <p class="mechanic-tile__desc">将此角色放回角色牌堆底。发动后摸 1 张手牌。角色可循环使用，是常规技能成本。</p>
        </div>
        <div class="mechanic-tile" style="--tile-color: var(--color-role-defend);">
          <div class="mechanic-tile__icon">OUT</div>
          <h3 class="mechanic-tile__title">移出游戏</h3>
          <p class="mechanic-tile__desc">暂时移出所有区域，不受任何效果影响。指定时机后移回原位，保持移出前状态。</p>
        </div>
        <div class="mechanic-tile" style="--tile-color: var(--color-role-attack);">
          <div class="mechanic-tile__icon">JUDGE</div>
          <h3 class="mechanic-tile__title">判定</h3>
          <p class="mechanic-tile__desc">展示牌堆顶 1 张牌，根据花色确定结果。红桃/方块为红色，黑桃/梅花为黑色。判定牌置入弃牌区。</p>
        </div>
        <div class="mechanic-tile" style="--tile-color: var(--color-mega-purple);">
          <div class="mechanic-tile__icon">DUEL</div>
          <h3 class="mechanic-tile__title">拼点</h3>
          <p class="mechanic-tile__desc">双方各选择并同时展示 1 张手牌。点数较高者拼点成功（A 最小，K 最大）。展示的牌置入弃牌区，平局没有胜者。</p>
        </div>
        <div class="mechanic-tile" style="--tile-color: var(--color-role-resource);">
          <div class="mechanic-tile__icon">ORB</div>
          <h3 class="mechanic-tile__title">充能球</h3>
          <p class="mechanic-tile__desc">置于己方本体旁且不占角色位，每名玩家至多3枚。所有己方故障机器人共享，可将其转化为不同效果。</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
