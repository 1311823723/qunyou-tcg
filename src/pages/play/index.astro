---
import Layout from "../../components/Layout.astro";
import { getBattleCatalog } from "../../lib/battle-catalog";

const catalog = getBattleCatalog();
---
<Layout title="在线对战大厅" description="进入宝旅团 TCG 在线大厅，创建、加入或观战 1v1 对局。">
  <div class="page-wrap battle-hall">
    <section class="battle-hall__hero">
      <div>
        <span class="battle-entry__eyebrow"><i></i> ONLINE BATTLE HALL</span>
        <h1>在线对战大厅</h1>
        <p>查看公开房间，加入等待中的牌桌，或观看已经开始的对局。</p>
      </div>
      <div class="battle-hall__profile" id="battle-hall-profile" hidden>
        <span>当前玩家</span>
        <strong data-profile-name>未设置</strong>
        <button type="button" class="battle-small-btn" data-edit-profile>修改用户名</button>
      </div>
    </section>

    <div id="battle-invite-banner" class="battle-entry__invite-banner" role="status" hidden>
      <span>收到对战邀请</span>
      <strong>房间 <b data-invited-room>------</b> 已为你标出</strong>
      <p>确认用户名后即可加入、重连或观战。</p>
    </div>

    <section class="battle-hall__actions" aria-label="大厅操作">
      <article class="hud-panel battle-hall__action battle-hall__action--create">
        <span class="battle-entry__step">01</span>
        <div><small>HOST A MATCH</small><h2>创建房间</h2><p>创建后进入现有准备室选择阵容。</p></div>
        <button type="button" class="btn btn--primary" id="battle-create-room">选择对战模式</button>
        <p class="battle-form__status" id="battle-create-status" aria-live="polite" hidden></p>
      </article>

      <article class="hud-panel battle-hall__action">
        <span class="battle-entry__step">02</span>
        <div><small>ROOM CODE</small><h2>按编号进入</h2><p>等待房会加入，对局房会进入观战。</p></div>
        <form id="battle-code-form" class="battle-hall__code-form">
          <input name="roomCode" class="battle-room-input" minlength="6" maxlength="6" required autocomplete="off" placeholder="6 位房间码" inputmode="text" autocapitalize="characters" spellcheck="false" aria-label="房间码" />
          <button class="btn btn--secondary" type="submit">进入</button>
        </form>
        <p class="battle-form__status" data-form-status aria-live="polite" hidden></p>
      </article>
    </section>

    <section class="battle-hall__rooms" aria-labelledby="battle-hall-title">
      <header class="battle-hall__rooms-heading">
        <div>
          <span class="battle-entry__eyebrow"><i></i> PUBLIC ROOMS</span>
          <h2 id="battle-hall-title">公开房间</h2>
          <p id="battle-hall-summary">正在读取大厅状态…</p>
        </div>
        <button type="button" class="battle-small-btn" id="battle-refresh-lobby">刷新大厅</button>
      </header>
      <div id="battle-hall-notice" class="battle-hall__notice" role="status" hidden></div>
      <div id="battle-room-list" class="battle-hall__room-grid" aria-live="polite">
        <div class="battle-hall__empty"><span></span><strong>正在连接大厅</strong><p>稍等一下，正在获取公开房间。</p></div>
      </div>
    </section>

    <section class="battle-entry__notes">
      <div class="battle-entry__notes-heading">
        <span class="battle-entry__eyebrow"><i></i> 大厅说明</span>
        <h2>找到一桌，<br />直接开始</h2>
      </div>
      <div class="battle-entry__features">
        <article><span>01</span><strong>等待房可加入</strong><p>空位开放且房主在线时，可以直接进入准备室。</p></article>
        <article><span>02</span><strong>进行中可观战</strong><p>观战者只能查看公开信息，不能操作牌桌。</p></article>
        <article><span>03</span><strong>同浏览器可重连</strong><p>用户名与座位记录保存在当前浏览器中。</p></article>
      </div>
    </section>
  </div>

  <dialog id="battle-profile-dialog" class="battle-dialog battle-profile-dialog" aria-labelledby="battle-profile-title">
    <form method="dialog" id="battle-profile-form" class="battle-profile-form">
      <span class="battle-kicker">PLAYER PROFILE</span>
      <h2 id="battle-profile-title">设置你的用户名</h2>
      <p>用户名只保存在当前浏览器，用于创建房间、加入对局和观战日志。</p>
      <label>用户名<input name="nickname" maxlength="20" required autocomplete="nickname" placeholder="1–20 个字符" /></label>
      <p class="battle-form__status" data-form-status aria-live="polite" hidden></p>
      <button type="submit" class="btn btn--primary">进入大厅</button>
    </form>
  </dialog>

  <dialog id="battle-mode-dialog" class="battle-dialog battle-mode-dialog" aria-labelledby="battle-mode-title">
    <form method="dialog" class="battle-mode-form">
      <span class="battle-kicker">CREATE A ROOM</span>
      <h2 id="battle-mode-title">选择对战模式</h2>
      <p>房间创建后模式不可切换。自动对战仍处于 Beta，经典牌桌会继续保留。</p>
      <div class="battle-mode-options">
        <button type="button" class="battle-mode-option is-featured" data-create-mode="auto">
          <span>推荐 · BETA</span><strong>自动对战</strong><small>自动结算阶段、手牌、本体，以及 8 套预组中的全部角色技能。</small>
        </button>
        <button type="button" class="battle-mode-option" data-create-mode="classic">
          <span>CLASSIC</span><strong>经典对战</strong><small>保留现有手动牌桌，由双方自行声明和结算全部效果。</small>
        </button>
      </div>
      <button type="button" class="battle-small-btn" data-mode-cancel>取消</button>
    </form>
  </dialog>

  <script id="battle-entry-catalog" type="application/json" set:html={JSON.stringify(catalog)}></script>
</Layout>

<script>
  import { getBattleApiUrl } from "../../lib/battle-api";
  import {
    PENDING_KEY,
    getBattleToken,
    isActivePlayerRoom,
    markActiveRoom,
    markActiveRoomWithMode,
    nextLobbyPollDelay,
    normalizeNickname,
    readPending,
    readProfile,
    saveProfile,
  } from "../../scripts/battle-profile";

  type LobbyRoom = {
    mode?: "classic" | "auto";
    roomCode: string;
    status: "waiting" | "playing";
    players: Array<{ nickname: string; connected: boolean }>;
    playerCount: number;
    capacity: 2;
    joinable: boolean;
    spectatorCount: number;
    createdAt: number;
    startedAt?: number;
    updatedAt: number;
  };

  const API_URL = getBattleApiUrl();
  const CUSTOM_DECK_ID = "custom";
  const catalog = JSON.parse(document.querySelector("#battle-entry-catalog")?.textContent || "{}") as {
    cards?: Record<string, { kind?: string }>;
    decks?: Array<{ id: string }>;
  };
  const profileDialog = document.querySelector<HTMLDialogElement>("#battle-profile-dialog");
  const profileForm = document.querySelector<HTMLFormElement>("#battle-profile-form");
  const roomList = document.querySelector<HTMLElement>("#battle-room-list");
  const summary = document.querySelector<HTMLElement>("#battle-hall-summary");
  const notice = document.querySelector<HTMLElement>("#battle-hall-notice");
  const refreshButton = document.querySelector<HTMLButtonElement>("#battle-refresh-lobby");
  const invitedRoomCode = new URLSearchParams(location.search).get("room")?.trim().toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 6) || "";
  let currentProfile = readProfile();
  let rooms: LobbyRoom[] = [];
  let pollTimer = 0;
  let loadingLobby = false;

  function escapeHtml(value: unknown) {
    return String(value ?? "").replace(/[&<>'"]/g, (character) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
    })[character] || character);
  }

  function validCustomDeck(value: unknown) {
    if (!value || typeof value !== "object") return false;
    const deck = value as { bodyId?: string; characterIds?: unknown[] };
    return catalog.cards?.[deck.bodyId || ""]?.kind === "body"
      && Array.isArray(deck.characterIds)
      && deck.characterIds.length === 16
      && new Set(deck.characterIds).size === 16
      && deck.characterIds.every((id) => typeof id === "string" && catalog.cards?.[id]?.kind === "character");
  }

  function bootstrapLoadout() {
    const pending = readPending() as { deckId?: string; customDeck?: unknown };
    if (pending.deckId === CUSTOM_DECK_ID && validCustomDeck(pending.customDeck)) {
      return { deckId: CUSTOM_DECK_ID, customDeck: pending.customDeck };
    }
    if (catalog.decks?.some((deck) => deck.id === pending.deckId)) return { deckId: pending.deckId };
    return { deckId: catalog.decks?.[0]?.id || "" };
  }

  function handshakeLoadout(mode: "classic" | "auto") {
    const deck = mode === "auto"
      ? catalog.decks?.find((candidate) => candidate.autoReady)
      : catalog.decks?.[0];
    return { deckId: deck?.id || "" };
  }

  function savePendingProfile() {
    if (!currentProfile) return;
    localStorage.setItem(PENDING_KEY, JSON.stringify({ nickname: currentProfile.nickname, ...bootstrapLoadout() }));
  }

  function renderProfile() {
    const panel = document.querySelector<HTMLElement>("#battle-hall-profile");
    const name = document.querySelector<HTMLElement>("[data-profile-name]");
    if (panel) panel.hidden = !currentProfile;
    if (name) name.textContent = currentProfile?.nickname || "未设置";
  }

  function setStatus(element: HTMLElement | null, message: string, state = "info") {
    if (!element) return;
    element.textContent = message;
    element.dataset.state = state;
    element.hidden = !message;
  }

  function relativeTime(timestamp: number) {
    const minutes = Math.max(0, Math.floor((Date.now() - timestamp) / 60000));
    if (minutes < 1) return "刚刚";
    if (minutes < 60) return `${minutes} 分钟前`;
    return `${Math.floor(minutes / 60)} 小时前`;
  }

  function roomAction(room: LobbyRoom) {
    const active = isActivePlayerRoom(room.roomCode);
    if (active) return { label: "重新进入", mode: "player", disabled: false } as const;
    if (room.status === "playing") return { label: "进入观战", mode: "spectator", disabled: false } as const;
    if (room.joinable) return { label: "加入房间", mode: "player", disabled: false } as const;
    return { label: room.playerCount >= room.capacity ? "房间已满" : "房主暂离", mode: "player", disabled: true } as const;
  }

  function renderRooms() {
    if (!roomList || !summary) return;
    const waiting = rooms.filter((room) => room.status === "waiting").length;
    const playing = rooms.length - waiting;
    summary.textContent = rooms.length ? `${waiting} 个等待房 · ${playing} 个对局中` : "当前没有公开房间";
    if (!rooms.length) {
      roomList.innerHTML = `<div class="battle-hall__empty"><span></span><strong>大厅暂时空着</strong><p>现在没有公开房间，可以先创建一间牌桌。</p><button type="button" class="btn btn--primary" data-empty-create>创建第一间牌桌</button></div>`;
      roomList.querySelector<HTMLButtonElement>("[data-empty-create]")?.addEventListener("click", () => {
        document.querySelector<HTMLButtonElement>("#battle-create-room")?.click();
      });
      return;
    }
    roomList.innerHTML = rooms.map((room) => {
      const action = roomAction(room);
      const invited = room.roomCode === invitedRoomCode;
      const playerSeats = [0, 1].map((index) => {
        const player = room.players[index];
        return player
          ? `<span class="${player.connected ? "is-online" : "is-away"}"><i></i><b>${escapeHtml(player.nickname)}</b><small>${player.connected ? "在线" : "暂离"}</small></span>`
          : `<span class="is-empty"><i></i><b>等待加入</b><small>空位</small></span>`;
      }).join("");
      const mode = room.mode || "classic";
      return `<article class="battle-room-card ${room.status === "playing" ? "is-playing" : "is-waiting"} ${invited ? "is-invited" : ""}" data-room-code="${escapeHtml(room.roomCode)}">
        <header><span class="battle-room-card__status"><i></i>${room.status === "playing" ? "对局中" : "等待中"}</span><span class="battle-room-card__mode is-${mode}">${mode === "auto" ? "自动 Beta" : "经典"}</span><code>${escapeHtml(room.roomCode)}</code></header>
        <div class="battle-room-card__players">${playerSeats}</div>
        <div class="battle-room-card__meta"><span>${room.playerCount} / ${room.capacity} 玩家</span><span>${room.spectatorCount} 人观战</span><span>${relativeTime(room.createdAt)}</span></div>
        <button type="button" class="btn ${room.status === "playing" ? "btn--secondary" : "btn--primary"}" data-room-action="${action.mode}" data-room-code="${escapeHtml(room.roomCode)}" data-room-mode="${mode}" ${action.disabled ? "disabled" : ""}>${action.label}</button>
      </article>`;
    }).join("");
    roomList.querySelectorAll<HTMLButtonElement>("[data-room-action]").forEach((button) => {
      button.addEventListener("click", () => enterRoom(button.dataset.roomCode || "", button.dataset.roomAction === "spectator", button.dataset.roomMode === "auto" ? "auto" : "classic"));
    });
  }

  function scheduleLobbyPoll() {
    window.clearTimeout(pollTimer);
    const delay = nextLobbyPollDelay(rooms.length);
    if (delay) pollTimer = window.setTimeout(() => refreshLobby(), delay);
  }

  async function refreshLobby(manual = false) {
    if (!currentProfile || loadingLobby) return;
    loadingLobby = true;
    window.clearTimeout(pollTimer);
    if (refreshButton) refreshButton.disabled = true;
    if (manual) setStatus(notice, "正在刷新大厅…", "loading");
    try {
      const response = await fetch(`${API_URL}/lobby`, { cache: "no-store" });
      const result = await response.json().catch(() => ({})) as { rooms?: LobbyRoom[]; error?: string };
      if (!response.ok || !Array.isArray(result.rooms)) throw new Error(result.error || "大厅服务暂时不可用。");
      rooms = result.rooms;
      setStatus(notice, "");
      renderRooms();
    } catch (error) {
      setStatus(notice, `${error instanceof Error ? error.message : "大厅加载失败。"} 当前列表可能已经过期。`, "error");
      if (!rooms.length && roomList) roomList.innerHTML = `<div class="battle-hall__empty is-error"><span></span><strong>未能连接大厅</strong><p>仍可按房间码进入，或点击刷新重试。</p></div>`;
    } finally {
      loadingLobby = false;
      if (refreshButton) refreshButton.disabled = false;
      scheduleLobbyPoll();
    }
  }

  function enterRoom(code: string, spectator: boolean, mode: "classic" | "auto" = "classic") {
    const normalized = code.trim().toUpperCase();
    if (!/^[A-Z0-9]{6}$/.test(normalized) || !currentProfile) return;
    savePendingProfile();
    location.href = `${mode === "auto" ? "/play/auto/room" : "/play/room"}?code=${normalized}${spectator ? "&spectate=true" : ""}`;
  }

  function openProfileEditor() {
    const input = profileForm?.elements.namedItem("nickname") as HTMLInputElement | null;
    if (input) input.value = currentProfile?.nickname || "";
    profileDialog?.showModal();
    input?.focus();
  }

  profileForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const input = profileForm.elements.namedItem("nickname") as HTMLInputElement | null;
    try {
      currentProfile = saveProfile(input?.value);
      setStatus(profileForm.querySelector("[data-form-status]"), "");
      profileDialog?.close();
      renderProfile();
      refreshLobby();
    } catch (error) {
      setStatus(profileForm.querySelector("[data-form-status]"), error instanceof Error ? error.message : "用户名无效。", "error");
    }
  });
  profileDialog?.addEventListener("cancel", (event) => {
    if (!currentProfile) event.preventDefault();
  });

  document.querySelector("[data-edit-profile]")?.addEventListener("click", openProfileEditor);
  refreshButton?.addEventListener("click", () => refreshLobby(true));

  const codeForm = document.querySelector<HTMLFormElement>("#battle-code-form");
  const codeInput = codeForm?.elements.namedItem("roomCode") as HTMLInputElement | null;
  codeInput?.addEventListener("input", () => {
    codeInput.value = codeInput.value.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 6);
  });
  codeForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const code = normalizeNickname(codeInput?.value).toUpperCase();
    const status = codeForm.querySelector<HTMLElement>("[data-form-status]");
    if (!/^[A-Z0-9]{6}$/.test(code)) {
      setStatus(status, "请输入 6 位房间码（字母或数字）。", "error");
      return;
    }
    const room = rooms.find((item) => item.roomCode === code);
    let resolvedRoom = room;
    if (!resolvedRoom) {
      const response = await fetch(`${API_URL}/rooms/${code}/meta`);
      const meta = await response.json().catch(() => ({})) as { mode?: "classic" | "auto"; status?: "waiting" | "playing"; error?: string };
      if (!response.ok) return setStatus(status, meta.error || "房间不存在或已经过期。", "error");
      resolvedRoom = { roomCode: code, mode: meta.mode, status: meta.status || "waiting", players: [], playerCount: 0, capacity: 2, joinable: true, spectatorCount: 0, createdAt: Date.now(), updatedAt: Date.now() };
    }
    const spectator = resolvedRoom.status === "playing" && !isActivePlayerRoom(code);
    setStatus(status, spectator ? "正在进入观战模式。" : "正在进入房间。", "loading");
    enterRoom(code, spectator, resolvedRoom.mode || "classic");
  });

  const modeDialog = document.querySelector<HTMLDialogElement>("#battle-mode-dialog");
  document.querySelector<HTMLButtonElement>("#battle-create-room")?.addEventListener("click", () => {
    if (!currentProfile) return openProfileEditor();
    modeDialog?.showModal();
  });
  modeDialog?.querySelector<HTMLElement>("[data-mode-cancel]")?.addEventListener("click", () => modeDialog.close());
  modeDialog?.querySelectorAll<HTMLButtonElement>("[data-create-mode]").forEach((button) => button.addEventListener("click", async () => {
    const mode = button.dataset.createMode === "auto" ? "auto" : "classic";
    const status = document.querySelector<HTMLElement>("#battle-create-status");
    if (!currentProfile) return openProfileEditor();
    const loadout = bootstrapLoadout();
    button.disabled = true;
    setStatus(status, "正在创建房间…", "loading");
    try {
      const response = await fetch(`${API_URL}${mode === "auto" ? "/auto" : ""}/rooms`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ nickname: currentProfile.nickname, ...handshakeLoadout(mode), token: getBattleToken() }),
      });
      const result = await response.json().catch(() => ({})) as { roomCode?: string; error?: string };
      if (!response.ok || !result.roomCode) throw new Error(result.error || "创建房间失败。");
      localStorage.setItem(PENDING_KEY, JSON.stringify({ nickname: currentProfile.nickname, ...loadout }));
      if (mode === "auto") markActiveRoomWithMode(result.roomCode, "auto");
      else markActiveRoom(result.roomCode);
      location.href = `${mode === "auto" ? "/play/auto/room" : "/play/room"}?code=${result.roomCode}`;
    } catch (error) {
      setStatus(status, error instanceof Error ? error.message : "创建房间失败。", "error");
      button.disabled = false;
    }
  }));

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") refreshLobby();
  });

  if (invitedRoomCode) {
    if (codeInput) codeInput.value = invitedRoomCode;
    const banner = document.querySelector<HTMLElement>("#battle-invite-banner");
    if (banner) banner.hidden = false;
    const code = banner?.querySelector<HTMLElement>("[data-invited-room]");
    if (code) code.textContent = invitedRoomCode;
  }

  renderProfile();
  if (currentProfile) refreshLobby();
  else openProfileEditor();
</script>
