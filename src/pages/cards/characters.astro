---
import Layout from "../../components/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CharacterCard from "../../components/CharacterCard.astro";
import { allCharacters, MAIN_ROLES, ALL_TAGS } from "../../lib/cards";
import { allDecks, getDeckSlug } from "../../lib/decks";

const roleLabel = "定位";
const allLabel = "全部";
const deckFilters = allDecks.map((deck) => ({ id: deck.id, name: deck.name, slug: getDeckSlug(deck) }));
const characterDeckSlugs = new Map<string, string[]>();
for (const deck of deckFilters) {
  const characterIds = allDecks.find((item) => item.id === deck.id)?.characterIds || [];
  for (const characterId of characterIds) {
    characterDeckSlugs.set(characterId, [...(characterDeckSlugs.get(characterId) || []), deck.slug]);
  }
}
---

<Layout title="角色牌">
  <div class="page-wrap" id="characters-page" data-total={allCharacters.length}>
    <PageHeader title="角色牌" subtitle={`${allCharacters.length} 张 · 竖版 TCG 卡面`} />
    <div class="filter-panel scroll-reveal">
      <div class="filter-panel__primary">
        <input
          type="search"
          placeholder="搜索名称、技能…"
          id="filter-search"
          class="filter-search"
          autocomplete="off"
        />
        <button type="button" class="filter-reset" id="filter-reset" disabled>清空筛选</button>
      </div>
      <div class="filter-group filter-group--roles" aria-label="按角色定位筛选">
        <span class="filter-group__label">{roleLabel}</span>
        <button class="filter-chip is-active" data-filter="role" data-value="">{allLabel}</button>
        {MAIN_ROLES.map((r) => (
          <button class="filter-chip" data-filter="role" data-value={r}>{r}</button>
        ))}
      </div>
      <div class="filter-group filter-group--decks" aria-label="按所属预组筛选">
        <span class="filter-group__label">预组</span>
        <button class="filter-chip is-active" data-filter="deck" data-value="">{allLabel}</button>
        {deckFilters.map((deck) => (
          <button class="filter-chip" data-filter="deck" data-value={deck.slug}>{deck.name}</button>
        ))}
      </div>
      <details class="filter-more" id="tag-filter-panel">
        <summary class="filter-more__summary">
          <span>标签筛选</span>
          <span class="filter-more__hint">展开全部标签</span>
        </summary>
        <div class="filter-group filter-group--tags">
          <button class="filter-chip is-active" data-filter="tag" data-value="">{allLabel}</button>
          {ALL_TAGS.map((t) => (
            <button class="filter-chip" data-filter="tag" data-value={t}>{t}</button>
          ))}
        </div>
      </details>
      <div class="filter-group filter-group--view" aria-label="视图模式">
        <span class="filter-group__label">视图</span>
        <button class="filter-chip" data-view="detail">详情模式</button>
        <button class="filter-chip is-active" data-view="card">卡面模式</button>
      </div>
      <p class="filter-summary" id="filter-summary" aria-live="polite">显示全部 {allCharacters.length} 张角色牌</p>
    </div>

    <section class="recent-characters" id="recent-characters" hidden aria-labelledby="recent-characters-title">
      <header class="recent-characters__header">
        <div>
          <span>本机记录</span>
          <h2 id="recent-characters-title">最近查看</h2>
        </div>
        <button type="button" id="recent-characters-clear">清空记录</button>
      </header>
      <div class="recent-characters__list" id="recent-characters-list"></div>
    </section>
    <div id="filter-empty" class="empty-state" style="display:none;">
      <div class="empty-state__icon">🔍</div>
      <p>没有匹配的角色牌，试试调整筛选条件</p>
    </div>

    <!-- 详情模式 -->
    <div class="card-gallery card-gallery--chars" id="card-gallery-detail" style="display: none;">
      {allCharacters.map((c, i) => (
        <div
          class="filter-card scroll-reveal"
          data-role={c.mainRole}
          data-tags={c.tags.join(",")}
          data-name={c.name}
          data-skill={c.skillName}
          data-effect={c.effectText}
          data-decks={(characterDeckSlugs.get(c.id) || []).join(",")}
          data-id={c.id}
          style={`animation-delay: ${Math.min(i * 0.03, 1)}s`}
        >
          <CharacterCard character={c} showDeck />
        </div>
      ))}
    </div>

    <!-- 卡面模式 -->
    <div class="card-gallery card-gallery--thumbs" id="card-gallery-card">
      {allCharacters.map((c, i) => (
        <div
          class="filter-card thumb-card scroll-reveal"
          data-role={c.mainRole}
          data-tags={c.tags.join(",")}
          data-name={c.name}
          data-skill={c.skillName}
          data-effect={c.effectText}
          data-decks={(characterDeckSlugs.get(c.id) || []).join(",")}
          data-id={c.id}
          style={`animation-delay: ${Math.min(i * 0.02, 1)}s`}
        >
          <button type="button" class="thumb-card__btn" data-card-id={c.id} data-card-name={c.name} data-card-role={c.mainRole} data-card-skill={c.skillName} data-card-effect={c.effectText} data-card-timing={c.timing} data-card-cost={c.cost.type === "休整" ? `休整 ${c.cost.amount}` : c.cost.text || c.cost.type} aria-label={`查看 ${c.name}`}>
            <img src={`/cards/characters/${c.id}.webp`} width="250" height="350" alt="" loading="lazy" decoding="async" />
            <span class="thumb-card__name">{c.name}</span>
          </button>
        </div>
      ))}
    </div>
  </div>

  <!-- 卡牌放大对话框 -->
  <dialog id="card-zoom-dialog" class="card-zoom-dialog">
    <div class="card-zoom-dialog__content">
      <button type="button" class="card-zoom-dialog__close" aria-label="关闭">×</button>
      <div id="card-zoom-body"></div>
    </div>
  </dialog>
</Layout>

<script>
  const VIEW_STORAGE_KEY = "card-view-mode";
  const RECENT_STORAGE_KEY = "qunyou-tcg-recent-characters-v1";
  const RECENT_LIMIT = 12;
  const page = document.getElementById("characters-page") as HTMLElement | null;
  const totalCharacters = Number(page?.dataset.total || 0);
  const viewButtons = document.querySelectorAll<HTMLElement>("[data-view]");
  const detailGallery = document.getElementById("card-gallery-detail");
  const cardGallery = document.getElementById("card-gallery-card");
  const searchInput = document.getElementById("filter-search") as HTMLInputElement | null;
  const resetButton = document.getElementById("filter-reset") as HTMLButtonElement | null;
  const filterSummary = document.getElementById("filter-summary");
  const recentSection = document.getElementById("recent-characters") as HTMLElement | null;
  const recentList = document.getElementById("recent-characters-list");
  const recentClear = document.getElementById("recent-characters-clear");
  const zoomDialog = document.getElementById("card-zoom-dialog") as HTMLDialogElement | null;
  const zoomBody = document.getElementById("card-zoom-body");
  const cardButtons = new Map<string, HTMLButtonElement>();
  let zoomReturnFocus: HTMLElement | null = null;

  document.querySelectorAll<HTMLButtonElement>("#card-gallery-card .thumb-card__btn").forEach((button) => {
    const id = button.dataset.cardId;
    if (id) cardButtons.set(id, button);
  });

  function escapeHTML(value: string) {
    return value.replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    })[character] || character);
  }

  function getFilters() {
    const params = new URLSearchParams(window.location.search);
    return {
      role: params.get("role") || "",
      tag: params.get("tag") || "",
      deck: params.get("deck") || "",
      search: params.get("search") || "",
    };
  }

  function filterLabel(type: string, value: string) {
    const chip = [...document.querySelectorAll<HTMLElement>(`.filter-chip[data-filter="${type}"]`)]
      .find((item) => (item.dataset.value || "") === value);
    return chip?.textContent?.trim() || value;
  }

  function applyFilters() {
    const { role, tag, deck, search } = getFilters();
    const q = search.toLocaleLowerCase("zh-CN");
    document.querySelectorAll<HTMLElement>(".filter-card").forEach((card) => {
      const cardTags = (card.dataset.tags || "").split(",").filter(Boolean);
      const cardDecks = (card.dataset.decks || "").split(",").filter(Boolean);
      const searchText = [card.dataset.name, card.dataset.skill, card.dataset.effect].filter(Boolean).join(" ").toLocaleLowerCase("zh-CN");
      const matches = (!role || card.dataset.role === role)
        && (!tag || cardTags.includes(tag))
        && (!deck || cardDecks.includes(deck))
        && (!q || searchText.includes(q));
      card.style.display = matches ? "" : "none";
    });

    const currentView = localStorage.getItem(VIEW_STORAGE_KEY) === "detail" ? "detail" : "card";
    const activeGallery = currentView === "detail" ? detailGallery : cardGallery;
    const visible = activeGallery
      ? [...activeGallery.querySelectorAll<HTMLElement>(".filter-card")].filter((card) => card.style.display !== "none").length
      : 0;
    const empty = document.getElementById("filter-empty");
    if (empty) empty.style.display = visible === 0 ? "" : "none";
    const header = document.querySelector(".page-header__sub");
    if (header) header.textContent = `${visible} / ${totalCharacters} 张 · 竖版 TCG 卡面`;

    document.querySelectorAll<HTMLElement>(".filter-chip[data-filter]").forEach((chip) => {
      const type = chip.dataset.filter || "";
      const selected = ({ role, tag, deck } as Record<string, string>)[type] || "";
      chip.classList.toggle("is-active", (chip.dataset.value || "") === selected);
    });
    if (searchInput && searchInput.value !== search) searchInput.value = search;
    const tagPanel = document.getElementById("tag-filter-panel") as HTMLDetailsElement | null;
    if (tagPanel && tag) tagPanel.open = true;

    const parts = [
      search ? `搜索“${search}”` : "",
      role ? `定位：${filterLabel("role", role)}` : "",
      tag ? `标签：${filterLabel("tag", tag)}` : "",
      deck ? `预组：${filterLabel("deck", deck)}` : "",
    ].filter(Boolean);
    if (filterSummary) {
      filterSummary.textContent = parts.length
        ? `${parts.join(" · ")} · 显示 ${visible} / ${totalCharacters} 张`
        : `显示全部 ${totalCharacters} 张角色牌`;
    }
    if (resetButton) resetButton.disabled = parts.length === 0;
  }

  function updateURL(updates: Record<string, string>, replace = false) {
    const url = new URL(window.location.href);
    for (const [key, value] of Object.entries(updates)) {
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
    }
    window.history[replace ? "replaceState" : "pushState"]({}, "", url.toString());
    applyFilters();
  }

  document.querySelectorAll<HTMLElement>(".filter-chip[data-filter]").forEach((chip) => {
    chip.addEventListener("click", () => {
      const type = chip.dataset.filter;
      if (type) updateURL({ [type]: chip.dataset.value || "" });
    });
  });
  searchInput?.addEventListener("input", () => updateURL({ search: searchInput.value.trim() }, true));
  resetButton?.addEventListener("click", () => updateURL({ role: "", tag: "", deck: "", search: "" }));
  window.addEventListener("popstate", applyFilters);

  function setViewMode(mode: string) {
    const normalizedMode = mode === "detail" ? "detail" : "card";
    viewButtons.forEach((button) => button.classList.toggle("is-active", button.dataset.view === normalizedMode));
    if (detailGallery) detailGallery.style.display = normalizedMode === "detail" ? "" : "none";
    if (cardGallery) cardGallery.style.display = normalizedMode === "card" ? "" : "none";
    localStorage.setItem(VIEW_STORAGE_KEY, normalizedMode);
    applyFilters();
  }
  viewButtons.forEach((button) => button.addEventListener("click", () => setViewMode(button.dataset.view || "card")));

  function readRecentCharacters() {
    try {
      const stored = JSON.parse(localStorage.getItem(RECENT_STORAGE_KEY) || "[]");
      return Array.isArray(stored)
        ? stored.filter((id): id is string => typeof id === "string" && cardButtons.has(id)).slice(0, RECENT_LIMIT)
        : [];
    } catch {
      return [];
    }
  }

  function saveRecentCharacters(ids: string[]) {
    localStorage.setItem(RECENT_STORAGE_KEY, JSON.stringify(ids.slice(0, RECENT_LIMIT)));
    renderRecentCharacters();
  }

  function rememberCharacter(id: string) {
    if (!cardButtons.has(id)) return;
    saveRecentCharacters([id, ...readRecentCharacters().filter((item) => item !== id)]);
  }

  function renderRecentCharacters() {
    if (!recentSection || !recentList) return;
    const ids = readRecentCharacters();
    recentSection.hidden = ids.length === 0;
    recentList.replaceChildren();
    for (const id of ids) {
      const source = cardButtons.get(id);
      if (!source) continue;
      const item = document.createElement("article");
      item.className = "recent-character";
      const openButton = source.cloneNode(true) as HTMLButtonElement;
      openButton.className = "recent-character__open thumb-card__btn";
      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.className = "recent-character__remove";
      removeButton.dataset.recentRemove = id;
      removeButton.setAttribute("aria-label", `从最近查看中移除 ${source.dataset.cardName || "该卡牌"}`);
      removeButton.textContent = "×";
      item.append(openButton, removeButton);
      recentList.append(item);
    }
  }

  function showCardZoom(button: HTMLElement) {
    if (!zoomDialog || !zoomBody) return;
    const id = button.dataset.cardId || "";
    const name = button.dataset.cardName || "";
    const role = button.dataset.cardRole || "";
    const skill = button.dataset.cardSkill || "";
    const effect = button.dataset.cardEffect || "";
    const timing = button.dataset.cardTiming || "";
    const cost = button.dataset.cardCost || "";
    const roleColorMap: Record<string, string> = {
      "强攻": "attack", "防御": "defend", "资源": "resource",
      "控制": "control", "支援": "support", "伏击": "ambush",
    };
    const roleVar = roleColorMap[role] || "attack";
    zoomBody.innerHTML = `<div class="card-zoom">
      <div class="card-zoom__image">
        <img class="card-zoom__image-placeholder" src="/cards/characters/${encodeURIComponent(id)}.webp" width="250" height="350" alt="${escapeHTML(name)}" decoding="async" />
        <img class="card-zoom__image-hd" src="/cards-hd/characters/${encodeURIComponent(id)}.webp" width="750" height="1050" alt="${escapeHTML(name)} 高清卡图" decoding="async" />
        <span class="card-zoom__image-loading">正在加载高清卡图…</span>
      </div>
      <div class="card-zoom__info">
        <span class="tag-pill tag-pill--role" style="--role-color: var(--role-${roleVar});">${escapeHTML(role)}</span>
        <h2 class="card-zoom__name">${escapeHTML(name)}</h2>
        <div class="card-zoom__meta">
          <div class="card-zoom__meta-item"><span class="card-zoom__meta-label">技能名</span><span class="card-zoom__meta-value">${escapeHTML(skill)}</span></div>
          <div class="card-zoom__meta-item"><span class="card-zoom__meta-label">费用</span><span class="card-zoom__meta-value">${escapeHTML(cost)}</span></div>
          <div class="card-zoom__meta-item"><span class="card-zoom__meta-label">时机</span><span class="card-zoom__meta-value">${escapeHTML(timing)}</span></div>
        </div>
        <div class="card-zoom__effect-box"><span class="card-zoom__effect-label">效果</span><p class="card-zoom__effect">${escapeHTML(effect)}</p></div>
      </div>
    </div>`;
    const highResImage = zoomBody.querySelector<HTMLImageElement>(".card-zoom__image-hd");
    const loadingLabel = zoomBody.querySelector<HTMLElement>(".card-zoom__image-loading");
    const revealHighRes = () => {
      highResImage?.classList.add("is-loaded");
      if (loadingLabel) loadingLabel.hidden = true;
    };
    if (highResImage?.complete && highResImage.naturalWidth > 0) revealHighRes();
    else highResImage?.addEventListener("load", revealHighRes, { once: true });
    highResImage?.addEventListener("error", () => {
      highResImage.remove();
      if (loadingLabel) loadingLabel.textContent = "高清图加载失败，已显示普通卡图";
    }, { once: true });
    zoomReturnFocus = button.closest(".recent-character") ? (cardButtons.get(id) || null) : button;
    rememberCharacter(id);
    zoomDialog.showModal();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const removeButton = target.closest<HTMLElement>("[data-recent-remove]");
    if (removeButton) {
      saveRecentCharacters(readRecentCharacters().filter((id) => id !== removeButton.dataset.recentRemove));
      return;
    }
    const cardButton = target.closest<HTMLElement>(".thumb-card__btn");
    if (cardButton) {
      showCardZoom(cardButton);
      return;
    }
    if (target === zoomDialog || target.closest(".card-zoom-dialog__close")) zoomDialog?.close();
  });
  recentClear?.addEventListener("click", () => saveRecentCharacters([]));
  zoomDialog?.addEventListener("close", () => {
    const target = zoomReturnFocus;
    zoomReturnFocus = null;
    if (target?.isConnected) window.requestAnimationFrame(() => target.focus());
  });

  setViewMode(localStorage.getItem(VIEW_STORAGE_KEY) || "card");
  renderRecentCharacters();
</script>
