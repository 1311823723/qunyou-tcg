---
import Layout from "../../components/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import HandCardCollection from "../../components/HandCardCollection.astro";
import { allHandCards, getHandCardTotal, getSuitDistribution, SUIT_SYMBOLS, ALL_SUITS } from "../../lib/cards";

const total = getHandCardTotal();
const suitDist = getSuitDistribution();
const basics = allHandCards.filter((c) => c.handType === "基础");
const actions = allHandCards.filter((c) => c.handType === "行动");

// 计算牌堆概率
const handProbabilities = allHandCards.map((card) => {
  const count = card.cards.length;
  const probability = (count / total * 100).toFixed(1);
  const draw5 = ((1 - Math.pow((total - count) / total, 5)) * 100).toFixed(1);
  const draw2 = ((1 - Math.pow((total - count) / total, 2)) * 100).toFixed(1);
  return {
    ...card,
    count,
    probability,
    draw5,
    draw2,
  };
}).sort((a, b) => b.count - a.count);
---
<Layout title="手牌">
  <div class="page-wrap">
    <PageHeader title="手牌牌堆" subtitle={`${allHandCards.length} 种 · 共 ${total} 张 · 双方共用的攻防资源池。`} badge="SHARED DECK" />

    {basics.length > 0 && (
      <section class="mb-10 scroll-reveal">
        <h2 class="section-heading" style="font-size: 1rem;">基础牌</h2>
        <div class="card-gallery card-gallery--hand">
          {basics.map((c, i) => (
            <div class="scroll-reveal" style={`animation-delay: ${i * 0.1}s`}>
              <HandCardCollection card={c} />
            </div>
          ))}
        </div>
      </section>
    )}

    {actions.length > 0 && (
      <section class="mb-10 scroll-reveal">
        <h2 class="section-heading" style="font-size: 1rem;">行动牌</h2>
        <div class="card-gallery card-gallery--hand">
          {actions.map((c, i) => (
            <div class="scroll-reveal" style={`animation-delay: ${i * 0.1}s`}>
              <HandCardCollection card={c} />
            </div>
          ))}
        </div>
      </section>
    )}

    <details class="hud-panel hand-deck-analysis scroll-reveal">
      <summary>
        <span>
          <small>DECK ANALYSIS</small>
          <strong>查看牌堆构成与摸牌概率</strong>
        </span>
        <span class="hand-deck-analysis__toggle" aria-hidden="true">展开</span>
      </summary>
      <div class="hand-deck-analysis__content">
        <section aria-labelledby="suit-distribution-title">
          <h2 id="suit-distribution-title">花色分布</h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {ALL_SUITS.map((suit) => {
              const count = suitDist[suit] || 0;
              const red = suit === "红桃" || suit === "方块";
              return (
                <div class="hand-deck-analysis__suit">
                  <span class="text-2xl font-mono font-bold" style={red ? "color:#ff8888" : "color: var(--text-secondary)"}>{SUIT_SYMBOLS[suit]}</span>
                  <div class="dist-bar mt-2"><div class="dist-bar__fill" style={`width:${(count/total)*100}%;background:${red?"#e06060":"#7080a0"}`}></div></div>
                  <span class="text-xs font-mono mt-2 inline-block" style="color: var(--text-muted);">{suit} · {count}</span>
                </div>
              );
            })}
          </div>
        </section>

        <section aria-labelledby="hand-probability-title">
          <h2 id="hand-probability-title">牌堆概率</h2>
          <p class="skill-text mb-4">计算在共用 {total} 张手牌牌堆中，各牌的摸取概率。</p>
          <div class="hand-probability-table" tabindex="0" role="region" aria-label="牌堆概率表，可横向滚动">
            <table>
              <thead>
                <tr>
                  <th>牌名</th>
                  <th>数量</th>
                  <th>单张概率</th>
                  <th>首摸 5 张至少 1 张</th>
                  <th>每回合摸 2 张至少 1 张</th>
                </tr>
              </thead>
              <tbody>
                {handProbabilities.map((card, index) => (
                  <tr style={index % 2 === 0 ? "background: rgba(0,0,0,0.15);" : ""}>
                    <td>{card.name}</td>
                    <td>{card.count}</td>
                    <td>{card.probability}%</td>
                    <td>{card.draw5}%</td>
                    <td>{card.draw2}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs mt-3" style="color: var(--text-faint);">概率基于随机抽取计算，实际游戏会受弃牌、检索等操作影响。</p>
        </section>
      </div>
    </details>
  </div>

  <dialog id="hand-card-zoom-dialog" class="card-zoom-dialog">
    <div class="card-zoom-dialog__content">
      <button type="button" class="card-zoom-dialog__close" aria-label="关闭高清卡面">×</button>
      <div class="card-zoom hand-card-zoom">
        <div class="card-zoom__image">
          <img id="hand-card-zoom-image" width="250" height="350" alt="" decoding="async" hidden />
          <img id="hand-card-zoom-image-hd" class="card-zoom__image-hd" width="750" height="1050" alt="" decoding="async" hidden />
          <span id="hand-card-zoom-loading" class="card-zoom__image-loading">正在加载高清卡图…</span>
        </div>
        <div class="card-zoom__info">
          <span id="hand-card-zoom-type" class="tag-pill tag-pill--role"></span>
          <h2 id="hand-card-zoom-name" class="card-zoom__name"></h2>
          <div class="card-zoom__meta">
            <div class="card-zoom__meta-item">
              <span class="card-zoom__meta-label">花色</span>
              <span id="hand-card-zoom-suit" class="card-zoom__meta-value"></span>
            </div>
            <div class="card-zoom__meta-item">
              <span class="card-zoom__meta-label">点数</span>
              <span id="hand-card-zoom-rank" class="card-zoom__meta-value"></span>
            </div>
            <div class="card-zoom__meta-item">
              <span class="card-zoom__meta-label">时机</span>
              <span id="hand-card-zoom-timing" class="card-zoom__meta-value"></span>
            </div>
          </div>
          <div class="card-zoom__effect-box">
            <span class="card-zoom__effect-label">效果</span>
            <p id="hand-card-zoom-effect" class="card-zoom__effect"></p>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const zoomDialog = document.getElementById("hand-card-zoom-dialog") as HTMLDialogElement | null;
  const zoomClose = zoomDialog?.querySelector<HTMLButtonElement>(".card-zoom-dialog__close") ?? null;
  const zoomImage = document.getElementById("hand-card-zoom-image") as HTMLImageElement | null;
  const zoomImageHd = document.getElementById("hand-card-zoom-image-hd") as HTMLImageElement | null;
  const zoomLoading = document.getElementById("hand-card-zoom-loading");
  const zoomType = document.getElementById("hand-card-zoom-type");
  const zoomName = document.getElementById("hand-card-zoom-name");
  const zoomSuit = document.getElementById("hand-card-zoom-suit");
  const zoomRank = document.getElementById("hand-card-zoom-rank");
  const zoomTiming = document.getElementById("hand-card-zoom-timing");
  const zoomEffect = document.getElementById("hand-card-zoom-effect");
  let lastZoomTrigger: HTMLButtonElement | null = null;

  function setText(element: HTMLElement | null, value: string) {
    if (element) element.textContent = value;
  }

  function openHandCardZoom(trigger: HTMLButtonElement) {
    if (!zoomDialog || !zoomImage || !zoomImageHd) return;

    const name = trigger.dataset.cardName || "手牌";
    const suit = trigger.dataset.cardSuit || "";
    const rank = trigger.dataset.cardRank || "";
    const imagePath = trigger.dataset.cardImage || "";
    const highResImagePath = trigger.dataset.cardImageHd || imagePath;
    const alt = `${name}，${suit}${rank}`;

    lastZoomTrigger = trigger;
    setText(zoomType, `${trigger.dataset.cardType || "手牌"}牌`);
    setText(zoomName, name);
    setText(zoomSuit, suit);
    setText(zoomRank, rank);
    setText(zoomTiming, trigger.dataset.cardTiming || "");
    setText(zoomEffect, trigger.dataset.cardEffect || "");

    zoomImage.src = imagePath;
    zoomImage.alt = alt;
    zoomImage.hidden = false;
    zoomImageHd.classList.remove("is-loaded");
    zoomImageHd.src = highResImagePath;
    zoomImageHd.alt = `${alt}高清卡图`;
    zoomImageHd.hidden = false;
    if (zoomLoading) {
      zoomLoading.hidden = false;
      zoomLoading.textContent = "正在加载高清卡图…";
    }

    const revealHighRes = () => {
      zoomImageHd.classList.add("is-loaded");
      if (zoomLoading) zoomLoading.hidden = true;
    };
    if (zoomImageHd.complete && zoomImageHd.naturalWidth > 0) revealHighRes();
    else zoomImageHd.addEventListener("load", revealHighRes, { once: true });
    zoomImageHd.addEventListener("error", () => {
      zoomImageHd.hidden = true;
      if (zoomLoading) zoomLoading.textContent = "高清图加载失败，已显示普通卡图";
    }, { once: true });

    zoomDialog.showModal();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const trigger = target.closest<HTMLButtonElement>("[data-hand-card-face]");
    if (trigger) {
      openHandCardZoom(trigger);
      return;
    }
    if (target === zoomDialog || target === zoomClose || target.closest(".card-zoom-dialog__close")) {
      zoomDialog?.close();
    }
  });

  zoomDialog?.addEventListener("close", () => {
    lastZoomTrigger?.focus();
    lastZoomTrigger = null;
  });
</script>
